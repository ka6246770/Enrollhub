# EnrollHub backend configuration.
# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/recrutment

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Session cookie. Set to `none` (and use HTTPS) when the frontend and API are on
# different sites, e.g. a Vercel frontend calling a Render API. Keep `lax` when
# both are on the same domain.
COOKIE_SAMESITE=lax

# Long random string used to sign the admin session cookie.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Telegram notifications (Phase 3). Create a bot with @BotFather, then find your
# chat id via https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: a second person or group that also receives every registration.
TELEGRAM_SECOND_CHAT_ID=
# Used to verify incoming webhook calls (Phase 4).
TELEGRAM_WEBHOOK_SECRET=

# Email (Phase 4). Create an account at resend.com.
RESEND_API_KEY=
MAIL_FROM=EnrollHub <onboarding@resend.dev>
# Where a copy of every registration is emailed, with the recording attached.
# Leave empty to send only the Telegram alert. With Resend's shared testing
# address (onboarding@resend.dev) this must be the Resend account's own inbox.
OWNER_EMAIL=

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=10485760
DUPLICATE_WINDOW_HOURS=6
# Voice notes older than this many days are deleted by `npm run retention:voice`.
VOICE_RETENTION_DAYS=180
