{
  "name": "enrollhub-backend",
  "version": "1.0.0",
  "description": "EnrollHub API: offer registrations with voice notes, Telegram notifications, and the admin dashboard API.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "admin:set": "node src/scripts/set-admin.js",
    "telegram:webhook": "node src/scripts/set-webhook.js",
    "retention:voice": "node src/scripts/cleanup-voice.js",
    "test:api": "bash test/api-smoke.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
