# Base URL of the EnrollHub backend API.
# Development: http://localhost:3001/api (see .env). Production: "/api" uses the
# same-origin rewrite below. Every page reads its records from this API; there
# is no bundled sample data.
#
# On Vercel (single domain, one project with services) set this to "/api" — the
# root vercel.json rewrites /api/* to the backend service, so a same-origin
# relative base works and needs no CORS or cross-site cookie config.
VITE_API_URL=

# SEO/GEO: canonical production origin, with no trailing slash. This is used
# for canonical links, Open Graph URLs, JSON-LD @ids and the generated sitemap.
# Replace the example domain before launch.
VITE_SITE_URL=https://enrollhub.example.com

# GEO: comma-separated, exact, verified sameAs URLs (official LinkedIn,
# Facebook, Wikipedia, or an official industry directory). Leave empty rather
# than guessing. Example shape:
# VITE_SAME_AS=https://www.linkedin.com/company/your-company,https://www.facebook.com/your-page
VITE_SAME_AS=

# GEO: optional facts published in Organization schema. Empty values are
# omitted from the JSON-LD instead of being published as placeholders.
VITE_SUPPORT_EMAIL=
VITE_WHATSAPP_NUMBER=
VITE_BUSINESS_ADDRESS=

# GEO: visible "reviewed" date and Article schema dates. Update when pay,
# eligibility or process facts change.
VITE_CONTENT_PUBLISHED_AT=2026-10-21
VITE_CONTENT_UPDATED_AT=2026-10-21
