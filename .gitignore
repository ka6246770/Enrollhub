# Dependencies
node_modules/

# Build output
dist/
build/

# React Email render output. The copy the API reads is backend/src/emails/,
# written by "npm run export" in emails/ (see emails/README.md).
emails/out/

# Environment files (never commit real secrets)
.env
.env.*
!.env.example

# Uploaded voice recordings
uploads/

# Neon CLI local project link (IDs only, still machine-specific)
.neon

# Agent skills are installed per machine under ~/.config/opencode/skills/
.agents/

# Local caches and test output
.cache/
.vite/
.turbo/
.eslintcache
coverage/
.nyc_output/
test-results/
playwright-report/
*.tsbuildinfo

# Editor and temporary files
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*.tmp
*.bak
*.pid
Thumbs.db
desktop.ini

# Logs and OS files
*.log
npm-debug.log*
.DS_Store
